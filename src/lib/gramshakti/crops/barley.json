tion-context.docx","block":2143,"sha256":"7ede9ad6efccba1d1ca81f60e6db605ec0f063ce142200dd78720c046483699e"}}],"url":"https://drive.google.com/file/d/1e9EXVD5b2MfbSr7UyhieBx8YooXf-wP1/view","classification":"Production Context estimate; not official district APY"}},"district":[],"production":[{"row":2114,"year":"2021-22","state":"Punjab","tonnes":15900.0,"authority":"Government of Punjab — Director, Agriculture and Farmers Welfare","publication":"Punjab at a Glance 2022","url":"https://punjab.gov.in/wp-content/uploads/2023/10/Punjab-at-Glance-2022-Punjabi-English.pdf","originalConversion":"thousand MT × 1,000","status":"INDEPENDENT_GOVT_VERIFIED"}],"sources":{"protection":[{"name":"Yellow Rust / Stripe Rust (Puccinia striiformis f. sp. hordei)","geography":"Northern Plains & Foothill Zones (Severe in Rajasthan, Haryana, Punjab, Western UP)","impact":"Bright yellow powdery pustules (urediniospores) arranged in parallel linear stripes along leaf veins; leaves turn yellow and dry up; spores easily dust onto fingers; field-wide infection under cool, humid weather reduces grain weight and shrivels kernels by 20–50%.","modes":["Chemical","Cultural"],"type":"Diseases","passage":"Barley — source table 105, row 2. Management modes are descriptive; formulations, rates and schedules omitted."},{"name":"Covered Smut (Ustilago hordei)","geography":"All Indian Belts (Seed-Borne)","impact":"The entire kernel is converted into a hard, black, compact mass of fungal spores enclosed by a persistent whitish-grey membrane; the membrane remains intact until threshing, when it ruptures, contaminating clean seed lots and giving the grain an unmarketable foul appearance.","modes":["Biological"],"type":"Diseases","passage":"Barley — source table 105, row 3. Management modes are descriptive; formulations, rates and schedules omitted."},{"name":"Spot Blotch / Leaf Blight (Bipolaris sorokiniana)","geography":"Humid Alluvial & Foothill Belts (Heavy in UP, Bihar, Punjab)","impact":"Small, dark brown-to-black elliptical spots appear on lower leaves; spots coalesce into irregular necrotic blights with yellow chlorotic halos; causes premature foliar drying and blackening of the grain tip (\"black point\").","modes":["Chemical"],"type":"Diseases","passage":"Barley — source table 105, row 4. Management modes are descriptive; formulations, rates and schedules omitted."},{"name":"Termites (Odontotermes obesus, Microtermes obesi)","geography":"Sandy Loam & Rainfed Arid Tracts (Rajasthan, South Haryana)","impact":"Worker termites feed on underground roots and stem bases; plants dry up, turn yellow, and pull out easily from the soil; hollowed stems are packed with earth; causes patchy plant mortality.","modes":["Chemical"],"type":"Diseases","passage":"Barley — source table 105, row 5. Management modes are descriptive; formulations, rates and schedules omitted."},{"name":"Corn Leaf Aphid / Barley Aphid (Rhopalosiphum maidis, R. padi)","geography":"Late Vegetative to Heading Stage (All Commercial Belts)","impact":"Dark bluish-green aphids form dense colonies inside leaf whorls, on flag leaves, and on developing earheads; suck phloem sap, causing leaf yellowing and curling; exude sticky honeydew that fosters black sooty mold; vectors Barley Yellow Dwarf Virus (BYDV).","modes":["Chemical"],"type":"Pests","passage":"Barley — source table 105, row 6. Management modes are descriptive; formulations, rates and schedules omitted."},{"name":"Lesser Grain Borer & Khapra Beetle (Rhyzopertha dominica, Trogoderma granarium)","geography":"Malthouse Silos & Stored Grain Depots","impact":"Adult beetles and larvae bore into stored grain; hollow out the starchy endosperm, leaving fine flour dust and damaged germs; destroys germination energy, resulting in the rejection of commercial malt barley lots.","modes":["Chemical","Cultural"],"type":"Pests","passage":"Barley — source table 105, row 7. Management modes are descriptive; formulations, rates and schedules omitted."}]}}